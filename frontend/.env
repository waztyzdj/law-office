# 应用标题
VITE_APP_TITLE=敬德律师事务所
VITE_APP_EN_TITLE=JINGDE LAW FIRM
VITE_APP_SYSTEM_NAME=律师事务所案件管理系统
VITE_APP_SYSTEM_DESCRIPTION=专业、高效、便捷的律师事务所案件管理平台
VITE_APP_LOGIN_SUBTITLE=请登录您的账号以开始管理您的案件

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=vben-web-antd

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key
