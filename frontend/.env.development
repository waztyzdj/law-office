# 端口号
VITE_PORT=5666

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=true

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# FormCreate 设计器 AI 助手配置。真实 token 请写入 .env.local，避免提交到仓库。
VITE_FORM_CREATE_AI_API=https://api.form-create.com/ai/v2/chat/form
